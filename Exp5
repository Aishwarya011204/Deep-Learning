from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.model_selection import train_test_split
X=np.linspace(0,10,150).reshape(-1,1); y=np.sin(X[:,0])+0.15*X[:,0]+np.random.normal(0,.35,150)
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.25,random_state=42)
degrees=[1,3,9,15]; train_err=[]; test_err=[]
grid=np.linspace(0,10,300).reshape(-1,1)
fig,axs=plt.subplots(2,2,figsize=(12,8))
for deg,ax in zip(degrees,axs.ravel()):
 model=make_pipeline(PolynomialFeatures(deg),LinearRegression()).fit(Xtr,ytr)
 ax.scatter(Xtr,ytr,s=12); ax.plot(grid,model.predict(grid),color='red'); ax.set_title(f'Degree {deg}')
 train_err.append(np.mean((model.predict(Xtr)-ytr)**2)); test_err.append(np.mean((model.predict(Xte)-yte)**2))
plt.tight_layout(); plt.show()
plt.plot(degrees,train_err,'o-',label='Train MSE'); plt.plot(degrees,test_err,'o-',label='Test MSE'); plt.xlabel('Polynomial degree'); plt.ylabel('MSE'); plt.legend(); plt.show()
print(pd.DataFrame({'degree':degrees,'train_MSE':train_err,'test_MSE':test_err}))
print("Best degree by test MSE:",degrees[int(np.argmin(test_err))])

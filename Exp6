# Compare optimisers on f(x,y)=x^2+4y^2
def grad(v): return np.array([2*v[0],8*v[1]])
start=np.array([4.,3.]); lr=.08; steps=60
paths={}
for method in ['Batch GD','SGD','Momentum','Adam']:
 v=start.copy(); m=np.zeros(2); vv=np.zeros(2); path=[v.copy()]
 for t in range(1,steps+1):
  g=grad(v)
  if method=='Momentum':
   m=.9*m+g; v-=lr*m
  elif method=='Adam':
   m=.9*m+.1*g; vv=.999*vv+.001*g*g
   v-=.15*(m/(1-.9**t))/(np.sqrt(vv/(1-.999**t))+1e-8)
  elif method=='SGD':
   g=g+np.random.normal(0,.15,2); v-=lr*g
  else: v-=lr*g
  path.append(v.copy())
 paths[method]=np.array(path)
x=np.linspace(-4,4,100); yv=np.linspace(-4,4,100); xx,yy=np.meshgrid(x,yv)
plt.contour(xx,yy,xx**2+4*yy**2,levels=20)
for name,path in paths.items(): plt.plot(path[:,0],path[:,1],label=name)
plt.legend(); plt.title('Optimiser paths'); plt.show()
print({k:round(float(p[-1,0]**2+4*p[-1,1]**2),5) for k,p in paths.items()})
# Keras regression comparison
import tensorflow as tf
from tensorflow import keras
Xr=np.random.rand(600,4); yr=2*Xr[:,0]+3*Xr[:,1]-Xr[:,2]+.5*np.random.randn(600)
histories={}
for name,opt in [('SGD',keras.optimizers.SGD(.03)),('Momentum',keras.optimizers.SGD(.03,momentum=.9)),('Adam',keras.optimizers.Adam(.03))]:
 model=keras.Sequential([keras.layers.Input((4,)),keras.layers.Dense(16,activation='relu'),keras.layers.Dense(1)])
 model.compile(optimizer=opt,loss='mse')
 h=model.fit(Xr,yr,epochs=25,batch_size=32,verbose=0,validation_split=.2)
 histories[name]=h.history['loss']
for n,l in histories.items(): plt.plot(l,label=n)
plt.xlabel('Epoch'); plt.ylabel('Loss'); plt.legend(); plt.show()

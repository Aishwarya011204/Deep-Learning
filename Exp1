customers = np.array([[5,2,0,1,3],[4,1,2,0,2],[0,5,4,1,0],[1,0,5,4,2],[3,2,1,5,4],[4,3,0,2,5]], dtype=float)
genre_book = np.array([[1,0,0,1],[0,1,0,0],[0,0,1,1],[1,0,1,0],[0,1,1,0]], dtype=float)
scores = customers @ genre_book
print("Dot product:", np.dot(customers[0], customers[1]))
print("Matrix product (customer-book scores):\n", scores)
print("Transpose shape:", customers.T.shape)
print("Element-wise square:\n", customers**2)
print("Inverse of valid square matrix:\n", np.linalg.inv(np.array([[2.,1.],[1.,2.]])))
norm = customers / np.linalg.norm(customers, axis=1, keepdims=True)
sim = norm @ norm.T
print("Cosine similarity:\n", np.round(sim, 2))
np.fill_diagonal(sim, -1)
i,j = np.unravel_index(np.argmax(sim), sim.shape)
print("Most similar customers:", i+1, "and", j+1, "similarity =", round(sim[i,j],3))
x = customers[0]; W = np.array([[.2,.1,.3,.4,.2],[.1,.5,.2,.1,.3]])
b = np.array([.5,.2])
print("Dense layer y=Wx+b:", W@x+b)
plt.imshow(scores, aspect='auto'); plt.colorbar(); plt.xlabel("Book"); plt.ylabel("Customer"); plt.title("Customer–Book Score Heatmap"); plt.show()

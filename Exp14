import networkx as nx
rnn=keras.Sequential([keras.layers.Input((5,3)),keras.layers.SimpleRNN(3,return_sequences=True)])
sample=np.random.rand(1,5,3).astype('float32'); rnn(sample)
W,U,b=rnn.layers[0].get_weights()
hstate=np.zeros(3); states=[]
for xt in sample[0]:
 hstate=np.tanh(xt@W+hstate@U+b); states.append(hstate.copy())
keras_states=rnn(sample).numpy()[0]
print("Manual states:\n",np.round(states,3)); print("Keras states:\n",np.round(keras_states,3))
G=nx.DiGraph()
for t in range(1,6):
 G.add_node(f'x{t}',pos=(t,1)); G.add_node(f'h{t}',pos=(t,0))
 G.add_edge(f'x{t}',f'h{t}',label='W_xh');
 if t>1:G.add_edge(f'h{t-1}',f'h{t}',label='W_hh')
pos=nx.get_node_attributes(G,'pos'); nx.draw(G,pos,with_labels=True,node_size=1400); nx.draw_networkx_edge_labels(G,pos,edge_labels=nx.get_edge_attributes(G,'label')); plt.show()
plt.plot(np.array(states));plt.xlabel('Time step');plt.ylabel('Hidden unit value');plt.title('Hidden states');plt.show()

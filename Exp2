df = pd.DataFrame({
 'Haemoglobin':np.random.normal(13,1.5,200),
 'RBC':np.random.normal(4.8,.5,200),
 'Glucose':np.random.normal(100,15,200),
 'Cholesterol':np.random.normal(190,25,200),
 'BMI':np.random.normal(25,4,200)})
df['RBC'] += (df['Haemoglobin']-13)*.15
z = (df-df.mean())/df.std(ddof=0)
cov, corr = z.cov(), z.corr()
fig,ax=plt.subplots(1,2,figsize=(12,4))
for a,m,t in zip(ax,[cov,corr],['Covariance','Correlation']):
 im=a.imshow(m,cmap='coolwarm',vmin=-1,vmax=1); a.set_xticks(range(5),m.columns,rotation=90); a.set_yticks(range(5),m.columns); a.set_title(t); fig.colorbar(im,ax=a)
plt.tight_layout(); plt.show()
vals, vecs=np.linalg.eigh(cov); order=np.argsort(vals)[::-1]; vals,vecs=vals[order],vecs[:,order]
print("Eigenvalues:", vals)
print("Variance captured (%):", np.round(vals/vals.sum()*100,2))
plt.scatter(z.iloc[:,0],z.iloc[:,1],alpha=.4)
center=z.iloc[:,:2].mean().values
for k in range(2):
 plt.arrow(center[0],center[1],vecs[0,k]*2,vecs[1,k]*2,head_width=.1)
plt.xlabel('Standardised haemoglobin'); plt.ylabel('Standardised RBC'); plt.title('Data and top eigenvector directions'); plt.show()

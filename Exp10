import tensorflow as tf
from tensorflow import keras
import pandas as pd
from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score

X,y=make_classification(n_samples=600,n_features=12,n_informative=5,random_state=7)
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.25,random_state=42)
sc=StandardScaler(); Xtr=sc.fit_transform(Xtr); Xte=sc.transform(Xte)
results=[]

def build(reg=0,drop=0):
 return keras.Sequential([keras.layers.Input((12,)),keras.layers.Dense(128,activation='relu',kernel_regularizer=keras.regularizers.l2(reg)),keras.layers.Dropout(drop),keras.layers.Dense(64,activation='relu',kernel_regularizer=keras.regularizers.l2(reg)),keras.layers.Dense(1,activation='sigmoid')])

for label,reg,drop,early in [('Baseline',0,0,False),('L2 .001',.001,0,False),('L2 .01',.01,0,False),('Dropout .2',0,.2,False),('Dropout .5',0,.5,False),('Early stopping',0,.2,True)]:
 m=build(reg,drop); m.compile(optimizer='adam',loss='binary_crossentropy',metrics=['accuracy'])
 cb=[keras.callbacks.EarlyStopping(patience=4,restore_best_weights=True)] if early else []
 hh=m.fit(Xtr,ytr,epochs=35,validation_split=.2,verbose=0,callbacks=cb)
 tr=accuracy_score(ytr,(m.predict(Xtr,verbose=0).ravel()>.5)); te=accuracy_score(yte,(m.predict(Xte,verbose=0).ravel()>.5))
 results.append([label,tr,te,tr-te])

print(pd.DataFrame(results,columns=['Model','Train accuracy','Test accuracy','Train-test gap']))

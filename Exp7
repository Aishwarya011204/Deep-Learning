def step(z): return (z>=0).astype(int)
X=np.array([[0,0],[0,1],[1,0],[1,1]])
y=np.array([0,0,0,1])
w=np.zeros(2); b=0.; lr=.1
for epoch in range(20):
 errors=0
 for xi,yi in zip(X,y):
  pred=int(step(np.dot(w,xi)+b)); update=lr*(yi-pred); w+=update*xi; b+=update
  errors += int(pred!=yi)
 if errors==0: break
print("AND perceptron weights/bias:",w,b,"predictions:",step(X@w+b))
# XOR cannot be represented by a single linear boundary
xor=np.array([0,1,1,0]); w=np.zeros(2); b=0.
for epoch in range(20):
 for xi,yi in zip(X,xor):
  pred=int(step(xi@w+b)); upd=.1*(yi-pred); w+=upd*xi; b+=upd
 print("",end="")
print("XOR predictions from single perceptron:",step(X@w+b),"targets:",xor)
z=np.linspace(-3,3,200)
plt.plot(z,(z>=0).astype(float),label='Step'); plt.plot(z,1/(1+np.exp(-z)),label='Sigmoid'); plt.plot(z,np.maximum(0,z),label='ReLU')
plt.legend(); plt.title('Activation functions'); plt.show()
